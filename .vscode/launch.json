{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex Debug (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/GD32F303CCT6_Pro",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/openocd.cfg"
      ],
      "device": "GD32F303CC",
      "svdFile": "",
      "preLaunchTask": "Build (CMake Debug)",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "preLaunchCommands": [
        "set {int}0xE000ED08 = 0x08000000"
      ],
      "postRestartCommands": [
        "breakpoint set --name HardFault_Handler"
      ]
    },
    {
      "name": "Cortex Debug (J-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/GD32F303CCT6_Pro",
      "servertype": "jlink",
      "device": "GD32F303CC",
      "interface": "swd",
      "preLaunchTask": "Build (CMake Debug)",
      "runToEntryPoint": "main"
    }
  ]
}
